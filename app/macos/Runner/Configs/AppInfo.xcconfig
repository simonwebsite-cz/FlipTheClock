// Application-level settings for the Runner target.

// The bundle/executable name. Kept free of punctuation so the on-disk
// bundle is FlipTheClock.app; the user-visible name (with the "!") comes
// from CFBundleDisplayName in Info.plist.
PRODUCT_NAME = FlipTheClock

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = cz.tichysimon.flipTheClock

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright (c) 2026 Simon Tichy. Released under the MIT License.
